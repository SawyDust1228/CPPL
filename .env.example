# LangChain chat-model provider and model
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4.1

# Credentials and optional custom endpoint
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.openai.com/v1

# Optional generation overrides
# LLM_TEMPERATURE=0
# LLM_TOP_P=1
# LLM_REASONING_EFFORT=medium
# LLM_TIMEOUT=90
# LLM_MAX_TOKENS=12000

# Optional CPPL Agent Runtime overrides
# CPPL_AGENT_MAX_PARALLELISM=4
# CPPL_AGENT_CONTEXT_WINDOW=32768
# CPPL_AGENT_OUTPUT_TOKENS=12000
# CPPL_AGENT_SAFETY_MARGIN=2048
# CPPL_AGENT_CACHE_ENABLED=true
# CPPL_AGENT_CACHE_DIR=.cppl/cache
# CPPL_AGENT_FAIL_FAST=true
# CPPL_AGENT_LOG_ENABLED=true
# CPPL_AGENT_TRANSPORT_RETRIES=2
# CPPL_AGENT_REQUEST_TIMEOUT=90

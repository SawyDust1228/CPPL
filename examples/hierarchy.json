[
  {
    "name": "Adder8",
    "ports": {
      "a": { "dir": "input", "width": 8 },
      "b": { "dir": "input", "width": 8 },
      "sum": { "dir": "output", "width": 8 }
    },
    "body": [
      { "id": "result", "op": "add", "args": ["a", "b"] },
      { "op": "output", "args": { "sum": "result" } }
    ]
  },
  {
    "name": "Top",
    "ports": {
      "x": { "dir": "input", "width": 8 },
      "y": { "dir": "input", "width": 8 },
      "z": { "dir": "output", "width": 8 }
    },
    "body": [
      {
        "id": ["adder_out"],
        "op": "instance",
        "module": "Adder8",
        "args": { "a": "x", "b": "y" }
      },
      { "op": "output", "args": { "z": "adder_out" } }
    ]
  }
]
